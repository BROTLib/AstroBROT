CheckNear(0.0003533658426135844, fb.d_ra, 1.0E-7, 'Golden_Ra_355 d_ra');
CheckNear(0.00012832548964958335, fb.d_dec, 1.0E-7, 'Golden_Ra_355 d_dec');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
