    </Method>
    <Method Name="Golden_South_Ra_180" Id="{d50d28b8-4e6e-450f-b923-0d7a01b63ce9}">
      <Declaration><![CDATA[METHOD PRIVATE Golden_South_Ra_180
VAR
	fb	: AstroBROT.FB_CO_NUTATE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Golden_South_Ra_180');
fb(jd := 2461000.3, ra := 180.0, dec := -40.0);
CheckNear(-0.001198590003980371, fb.d_ra, 1.0E-7, 'Golden_South_Ra_180 d_ra');
