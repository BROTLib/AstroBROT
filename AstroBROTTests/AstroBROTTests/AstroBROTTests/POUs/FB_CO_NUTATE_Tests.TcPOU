    </Method>
    <Method Name="Unwrapped_Ra_Equals_Wrapped_Ra" Id="{ae403ff3-0fd4-4aa6-a5be-0dc4614c58b8}">
      <Declaration><![CDATA[METHOD PRIVATE Unwrapped_Ra_Equals_Wrapped_Ra
VAR
	fbA, fbB	: AstroBROT.FB_CO_NUTATE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Unwrapped_Ra_Equals_Wrapped_Ra');
// ra and ra + 360 are the same direction, so the RA correction must agree (before the fix ra = -5 gave 360.0004)
fbA(jd := 2461000.3, ra := -5.0, dec := 10.0);
fbB(jd := 2461000.3, ra := 355.0, dec := 10.0);
CheckNear(fbB.d_ra, fbA.d_ra, 1.0E-9, 'd_ra(-5) = d_ra(355)');
CheckNear(fbB.d_dec, fbA.d_dec, 1.0E-9, 'd_dec(-5) = d_dec(355)');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="D_Ra_Stays_Small_For_Any_Ra" Id="{52d3769c-a5e7-4558-8572-c4d514a1b180}">
      <Declaration><![CDATA[METHOD PRIVATE D_Ra_Stays_Small_For_Any_Ra
VAR
	fb	: AstroBROT.FB_CO_NUTATE;
	i	: INT;
	fMax, fAbs	: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('D_Ra_Stays_Small_For_Any_Ra');
// FB_HADEC2RADEC can pass any ra in (-360, 360); nutation moves RA by at most ~0.011 deg at |dec| <= 60
fMax := 0.0;
FOR i := -24 TO 48 DO
	fb(jd := 2461000.3, ra := INT_TO_LREAL(i) * 15.0 + 0.5, dec := 10.0);
	fAbs := ABS(fb.d_ra);
	IF fAbs > fMax THEN fMax := fAbs; END_IF
END_FOR
AssertTrue(Condition := fMax < 0.02, Message := 'max |d_ra| over ra -360..720 is below 0.02 deg');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>