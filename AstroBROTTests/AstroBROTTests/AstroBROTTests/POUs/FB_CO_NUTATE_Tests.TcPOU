<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_CO_NUTATE_Tests" Id="{3612eb0b-61ad-4a86-8278-a6c484b6e4b9}" SpecialFunc="None">
    <Declaration><![CDATA[// Tests for AstroBROT.FB_CO_NUTATE (RA/Dec corrections due to nutation).
//
// Golden values come from AstroBROT/testing/astrobrot_port.py (co_nutate), tolerance 1e-7 deg.
// Issue #10: d_ra was ra2 - ra with ra2 in [0, 360) and ra unwrapped, so ra = -5 gave d_ra = 360.0004 instead of
// 0.00035. The fix wraps d_ra to [-180, 180).
FUNCTION_BLOCK FB_CO_NUTATE_Tests EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Golden_Ra_Minus_5();
Golden_Ra_355();
Golden_Ra_0_001();
Golden_Ra_359_999();
Golden_Ra_365();
Golden_South_Ra_Minus_0_001();
Golden_South_Ra_180();
Unwrapped_Ra_Equals_Wrapped_Ra();
D_Ra_Stays_Small_For_Any_Ra();
]]></ST>
    </Implementation>
    <Method Name="CheckNear" Id="{a79b6e49-9313-4fee-840e-25e3d8fe1155}">
      <Declaration><![CDATA[METHOD PRIVATE CheckNear
VAR_INPUT
	fExpected	: LREAL;
	fActual		: LREAL;
	fDelta		: LREAL;
	sName		: STRING(255);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[AssertEquals_LREAL(Expected := fExpected, Actual := fActual, Delta := fDelta, Message := sName);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Golden_Ra_Minus_5" Id="{f4582a4d-6952-4751-aceb-4703680c6a5b}">
      <Declaration><![CDATA[METHOD PRIVATE Golden_Ra_Minus_5
VAR
	fb	: AstroBROT.FB_CO_NUTATE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Golden_Ra_Minus_5');
fb(jd := 2461000.3, ra := -5.0, dec := 10.0);
CheckNear(0.00035336584255674097, fb.d_ra, 1.0E-7, 'Golden_Ra_Minus_5 d_ra');
CheckNear(0.00012832548964958335, fb.d_dec, 1.0E-7, 'Golden_Ra_Minus_5 d_dec');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
