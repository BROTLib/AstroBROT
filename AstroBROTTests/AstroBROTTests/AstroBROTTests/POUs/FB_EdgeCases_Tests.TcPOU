<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_EdgeCases_Tests" Id="{1ce8b4dd-f252-5622-aeba-d16d757419d4}" SpecialFunc="None">
    <Declaration><![CDATA[// Edge cases of FB_EQ2HOR and FB_HOR2EQ: the celestial poles, an observer at a pole and on the equator, the zenith and
// the nadir, wrap-around of RA and azimuth, positions below the horizon and out-of-range angles.
//
// GENERATED by AstroBROT/testing/gen_block_tests.py from testing/golden_blocks.py, do not edit the numbers by hand.
// Every golden case is checked against the Python port of the ST (1E-7 deg) and against erfa (atco13 / atoc13) as a
// great-circle separation (2E-4 deg = 0.72 arcsec, no refraction, dut1 = 0). Altitude and azimuth are compared as a
// separation on the sky, not as two separate angle differences: near the zenith an azimuth difference is amplified by
// 1 / cos(alt) and says little about the pointing error (Azimuth_Difference_Is_Not_A_Sky_Separation).
FUNCTION_BLOCK FB_EdgeCases_Tests EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[EQ2HOR_North_celestial_pole();
EQ2HOR_South_celestial_pole();
EQ2HOR_RA_wrap_low();
EQ2HOR_RA_wrap_high();
EQ2HOR_Below_horizon();
EQ2HOR_Observer_at_north_pole();
EQ2HOR_Observer_at_south_pole();
EQ2HOR_Observer_on_equator();
HOR2EQ_Zenith_az0();
HOR2EQ_Zenith_az180();
HOR2EQ_Nadir();
HOR2EQ_Horizon_north();
HOR2EQ_Az_wrap_low();
HOR2EQ_Az_wrap_high();
HOR2EQ_Observer_at_north_pole();
HOR2EQ_Observer_at_south_pole();
HOR2EQ_Observer_on_equator();
HOR2EQ_Azimuth_Does_Not_Matter_At_The_Zenith();
HOR2EQ_Azimuth_Is_Periodic();
EQ2HOR_Right_Ascension_Is_Periodic();
EQ2HOR_Longitude_Is_Periodic();
EQ2HOR_Outputs_Stay_In_Range();
HOR2EQ_Outputs_Stay_In_Range();
Azimuth_Difference_Is_Not_A_Sky_Separation();
]]></ST>
    </Implementation>
    <Method Name="CheckNear" Id="{ae5cbb73-9f17-5456-abe9-3e9b636050b5}">
      <Declaration><![CDATA[METHOD PRIVATE CheckNear
VAR_INPUT
	fExpected	: LREAL;
	fActual	: LREAL;
	fDelta	: LREAL;
	sName	: STRING(255);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[AssertEquals_LREAL(Expected := fExpected, Actual := fActual, Delta := fDelta, Message := sName);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="CheckAngle" Id="{fd336346-3738-5635-b78e-b47f4140cf69}">
      <Declaration><![CDATA[METHOD PRIVATE CheckAngle
VAR_INPUT
	fExpected	: LREAL;
	fActual	: LREAL;
	fDelta	: LREAL;
	sName	: STRING(255);
END_VAR
VAR
	fDiff	: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// angles in degrees, compared modulo 360 so that 359.9999999 and -1.0E-7 are equal
fDiff := fActual - fExpected;
WHILE fDiff > 180.0 DO fDiff := fDiff - 360.0; END_WHILE
WHILE fDiff < -180.0 DO fDiff := fDiff + 360.0; END_WHILE
AssertEquals_LREAL(Expected := 0.0, Actual := fDiff, Delta := fDelta, Message := sName);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="CheckSeparation" Id="{831c8b0c-dd19-532e-b7cc-0fd2562e4b20}">
      <Declaration><![CDATA[METHOD PRIVATE CheckSeparation
VAR_INPUT
	fLon1	: LREAL;
	fLat1	: LREAL;
	fLon2	: LREAL;
	fLat2	: LREAL;
	fDelta	: LREAL;
	sName	: STRING(255);
END_VAR
VAR
	fD2r	: LREAL;
	fHalfDLat	: LREAL;
	fHalfDLon	: LREAL;
	fHav	: LREAL;
	fSep	: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// great-circle separation of two positions (longitude, latitude in degrees) against a tolerance in degrees;
// a difference of longitudes is not a distance on the sky, this is (haversine formula)
fD2r := 0.017453292519943295;
fHalfDLat := (fLat2 - fLat1) * fD2r * 0.5;
fHalfDLon := (fLon2 - fLon1) * fD2r * 0.5;
fHav := SIN(fHalfDLat) * SIN(fHalfDLat) + COS(fLat1 * fD2r) * COS(fLat2 * fD2r) * SIN(fHalfDLon) * SIN(fHalfDLon);
fSep := 2.0 * ASIN(SQRT(LIMIT(0.0, fHav, 1.0))) / fD2r;
AssertEquals_LREAL(Expected := 0.0, Actual := fSep, Delta := fDelta, Message := sName);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="EQ2HOR_North_celestial_pole" Id="{95d3a9f0-640d-5335-ba09-ca793b23a8b8}">
      <Declaration><![CDATA[METHOD PRIVATE EQ2HOR_North_celestial_pole
VAR
	fb	: AstroBROT.FB_EQ2HOR;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('EQ2HOR_North_celestial_pole');
fb(ra := 0.0, dec := 90.0, jd := 2461300.75, lon := -16.5, lat := 28.3, refract := FALSE);
CheckNear(28.250439967419368, fb.alt, 1.0E-7, 'North_celestial_pole alt');
CheckAngle(0.15978772490399448, fb.az, 1.0E-7, 'North_celestial_pole az');
CheckSeparation(0.159877225222193, 28.250414281534653, fb.az, fb.alt, 0.0002, 'North_celestial_pole vs erfa');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
