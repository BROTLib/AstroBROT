    <Method Name="HOR2EQ_Azimuth_Does_Not_Matter_At_The_Zenith" Id="{44d9fe50-648f-51d0-8226-c10a05a2a39f}">
      <Declaration><![CDATA[METHOD PRIVATE HOR2EQ_Azimuth_Does_Not_Matter_At_The_Zenith
VAR
	fbA	: AstroBROT.FB_HOR2EQ;
	fbB	: AstroBROT.FB_HOR2EQ;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('HOR2EQ_Azimuth_Does_Not_Matter_At_The_Zenith');
fbA(alt := 90.0, az := 0.0, jd := 2461300.75, lon := -16.5, lat := 28.3, refract := FALSE);
fbB(alt := 90.0, az := 180.0, jd := 2461300.75, lon := -16.5, lat := 28.3, refract := FALSE);
CheckAngle(fbA.ra, fbB.ra, 1.0E-9, 'ra');
CheckNear(fbA.dec, fbB.dec, 1.0E-9, 'dec');
AssertTrue(Condition := fbA.dec > 0.0 AND fbA.dec < 90.0, Message := 'the zenith of a northern site has 0 < dec < 90 (no NaN from ASIN)');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="HOR2EQ_Azimuth_Is_Periodic" Id="{99b74d67-2a2c-5b07-986a-244312c2c69c}">
      <Declaration><![CDATA[METHOD PRIVATE HOR2EQ_Azimuth_Is_Periodic
VAR
	fbRef	: AstroBROT.FB_HOR2EQ;
	fb	: AstroBROT.FB_HOR2EQ;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('HOR2EQ_Azimuth_Is_Periodic');
fbRef(alt := 45.0, az := 350.0, jd := 2461300.75, lon := -16.5, lat := 28.3, refract := FALSE);
fb(alt := 45.0, az := -10.0, jd := 2461300.75, lon := -16.5, lat := 28.3, refract := FALSE);
CheckAngle(fbRef.ra, fb.ra, 1.0E-9, 'az -10 ra');
CheckNear(fbRef.dec, fb.dec, 1.0E-9, 'az -10 dec');
fb(alt := 45.0, az := 710.0, jd := 2461300.75, lon := -16.5, lat := 28.3, refract := FALSE);
CheckAngle(fbRef.ra, fb.ra, 1.0E-9, 'az 710 ra');
CheckNear(fbRef.dec, fb.dec, 1.0E-9, 'az 710 dec');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="EQ2HOR_Right_Ascension_Is_Periodic" Id="{802adb4c-87c0-54df-b7b7-12df75e586ed}">
      <Declaration><![CDATA[METHOD PRIVATE EQ2HOR_Right_Ascension_Is_Periodic
VAR
	fbRef	: AstroBROT.FB_EQ2HOR;
	fb	: AstroBROT.FB_EQ2HOR;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('EQ2HOR_Right_Ascension_Is_Periodic');
fbRef(ra := 83.63, dec := 22.01, jd := 2461300.75, lon := -16.5, lat := 28.3, refract := FALSE);
fb(ra := -276.37, dec := 22.01, jd := 2461300.75, lon := -16.5, lat := 28.3, refract := FALSE);
CheckNear(fbRef.alt, fb.alt, 1.0E-9, 'ra -276.37 alt');
CheckAngle(fbRef.az, fb.az, 1.0E-9, 'ra -276.37 az');
fb(ra := 443.63, dec := 22.01, jd := 2461300.75, lon := -16.5, lat := 28.3, refract := FALSE);
CheckNear(fbRef.alt, fb.alt, 1.0E-9, 'ra 443.63 alt');
CheckAngle(fbRef.az, fb.az, 1.0E-9, 'ra 443.63 az');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="EQ2HOR_Longitude_Is_Periodic" Id="{ec0685f9-9ae2-5512-8a76-bad041ff1830}">
      <Declaration><![CDATA[METHOD PRIVATE EQ2HOR_Longitude_Is_Periodic
VAR
	fbRef	: AstroBROT.FB_EQ2HOR;
	fb	: AstroBROT.FB_EQ2HOR;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('EQ2HOR_Longitude_Is_Periodic');
fbRef(ra := 83.63, dec := 22.01, jd := 2461300.75, lon := -16.5, lat := 28.3, refract := FALSE);
fb(ra := 83.63, dec := 22.01, jd := 2461300.75, lon := 343.5, lat := 28.3, refract := FALSE);
CheckNear(fbRef.alt, fb.alt, 1.0E-9, 'lon 343.5 alt');
CheckAngle(fbRef.az, fb.az, 1.0E-9, 'lon 343.5 az');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="EQ2HOR_Outputs_Stay_In_Range" Id="{30c9487b-2186-5374-94c0-383dbeb4b040}">
      <Declaration><![CDATA[METHOD PRIVATE EQ2HOR_Outputs_Stay_In_Range
VAR
	fb	: AstroBROT.FB_EQ2HOR;
	i	: INT;
	fDec	: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('EQ2HOR_Outputs_Stay_In_Range');
// declinations from pole to pole for observers at both poles, on the equator and at a mid latitude
FOR i := -2 TO 2 DO
	fDec := 45.0 * i;
	fb(ra := 200.0, dec := fDec, jd := 2461300.75, lon := 0.0, lat := 90.0, refract := FALSE);
	AssertTrue(Condition := fb.alt >= -90.0 AND fb.alt <= 90.0 AND fb.az >= 0.0 AND fb.az <= 360.0, Message := 'observer at the north pole');
	fb(ra := 200.0, dec := fDec, jd := 2461300.75, lon := 0.0, lat := -90.0, refract := FALSE);
	AssertTrue(Condition := fb.alt >= -90.0 AND fb.alt <= 90.0 AND fb.az >= 0.0 AND fb.az <= 360.0, Message := 'observer at the south pole');
	fb(ra := 200.0, dec := fDec, jd := 2461300.75, lon := 0.0, lat := 0.0, refract := FALSE);
	AssertTrue(Condition := fb.alt >= -90.0 AND fb.alt <= 90.0 AND fb.az >= 0.0 AND fb.az <= 360.0, Message := 'observer on the equator');
	fb(ra := 200.0, dec := fDec, jd := 2461300.75, lon := -16.5, lat := 28.3, refract := FALSE);
	AssertTrue(Condition := fb.alt >= -90.0 AND fb.alt <= 90.0 AND fb.az >= 0.0 AND fb.az <= 360.0, Message := 'observer at 28.3 deg');
END_FOR
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="HOR2EQ_Outputs_Stay_In_Range" Id="{ad1345e8-9e47-5666-bbb8-5f56a69c4da0}">
      <Declaration><![CDATA[METHOD PRIVATE HOR2EQ_Outputs_Stay_In_Range
VAR
	fb	: AstroBROT.FB_HOR2EQ;
	i	: INT;
	fAlt	: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('HOR2EQ_Outputs_Stay_In_Range');
// altitudes from nadir to zenith, for observers at both poles, on the equator and at a mid latitude
FOR i := -2 TO 2 DO
	fAlt := 45.0 * i;
	fb(alt := fAlt, az := 100.0, jd := 2461300.75, lon := 0.0, lat := 90.0, refract := FALSE);
	AssertTrue(Condition := fb.dec >= -90.0 AND fb.dec <= 90.0 AND fb.ra >= 0.0 AND fb.ra < 360.0, Message := 'observer at the north pole');
	fb(alt := fAlt, az := 100.0, jd := 2461300.75, lon := 0.0, lat := -90.0, refract := FALSE);
	AssertTrue(Condition := fb.dec >= -90.0 AND fb.dec <= 90.0 AND fb.ra >= 0.0 AND fb.ra < 360.0, Message := 'observer at the south pole');
	fb(alt := fAlt, az := 100.0, jd := 2461300.75, lon := 0.0, lat := 0.0, refract := FALSE);
	AssertTrue(Condition := fb.dec >= -90.0 AND fb.dec <= 90.0 AND fb.ra >= 0.0 AND fb.ra < 360.0, Message := 'observer on the equator');
	fb(alt := fAlt, az := 100.0, jd := 2461300.75, lon := -16.5, lat := 28.3, refract := FALSE);
	AssertTrue(Condition := fb.dec >= -90.0 AND fb.dec <= 90.0 AND fb.ra >= 0.0 AND fb.ra < 360.0, Message := 'observer at 28.3 deg');
END_FOR
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Azimuth_Difference_Is_Not_A_Sky_Separation" Id="{1e01fdc4-d0df-561a-b0d1-30486cfa78ce}">
      <Declaration><![CDATA[METHOD PRIVATE Azimuth_Difference_Is_Not_A_Sky_Separation
VAR
	fb1	: AstroBROT.FB_EQ2HOR;
	fb2	: AstroBROT.FB_EQ2HOR;
	fAzDiff	: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Azimuth_Difference_Is_Not_A_Sky_Separation');
// The review recorded "azimuth outliers up to 40 arcsec" as a coordinate difference. Two positions 0.63 arcsec apart on the sky
// (0.05 deg from the zenith) differ by 629 arcsec in azimuth: the azimuth difference is amplified by 1 / cos(alt) = 1146.
// A raw azimuth difference therefore cannot be used as an accuracy figure; a great-circle separation can.
fb1(ra := 69.29947685614172, dec := 28.289165400359746, jd := 2461300.75, lon := -16.5, lat := 28.3, refract := FALSE);
fb2(ra := 69.29967685614173, dec := 28.289165400359746, jd := 2461300.75, lon := -16.5, lat := 28.3, refract := FALSE);
fAzDiff := fb2.az - fb1.az;
CheckNear(0.17470443800883118, fAzDiff, 1.0E-6, 'azimuth difference in degrees');
CheckSeparation(fb1.az, fb1.alt, fb2.az, fb2.alt, 0.00017709654618499777, 'separation of the two outputs is the sky separation');
AssertTrue(Condition := ABS(fAzDiff) > 100.0 * 0.00017609654618499777, Message := 'the azimuth difference is more than 100 times the separation');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
