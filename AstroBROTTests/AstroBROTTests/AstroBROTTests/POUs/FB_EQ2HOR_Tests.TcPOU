CheckAngle(229.80725126973925, fb.az, 1.0E-7, 'South_2010 dut1 +0.9 az');
fb(ra := 312.5, dec := -47.3, jd := 2455197.5, lon := -70.7, lat := -30.2, refract := FALSE, dut1 := -0.9);
CheckNear(29.982762840100285, fb.alt, 1.0E-7, 'South_2010 dut1 -0.9 alt');
