<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_EQ2HOR_Tests" Id="{163d4519-caea-4ce4-8abb-b23e20af8328}" SpecialFunc="None">
    <Declaration><![CDATA[// Tests for AstroBROT.FB_EQ2HOR (equatorial J2000 -> apparent horizontal coordinates).
//
// Golden values come from AstroBROT/testing/golden_astro.py (the Python port, validated against erfa). The port
// reproduces the ST to about 1e-10 deg, the tolerance here is 1e-7 deg (0.36 mas). Three sites: Tenerife 2026
// (high in the sky), Tenerife at about 20 deg altitude (refraction) and a southern site in 2010.
//
// Besides the numbers the tests pin down that the block never modifies its inputs and keeps no state between
// calls (issue #8). MAIN of the library assigns every input on every call, which hides both problems.
FUNCTION_BLOCK FB_EQ2HOR_Tests EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Golden_All_Corrections_Tenerife_2026();
Golden_All_Corrections_Tenerife_low();
Golden_All_Corrections_South_2010();
Golden_Nutation_And_Aberration_Switches();
Toggling_The_Switches_Keeps_No_Stale_Corrections();
Inputs_Are_Not_Modified();
Cyclic_Calls_With_Inputs_Set_Once_Are_Stable();
Refraction_Tenerife_low();
Refraction_South_2010();
Golden_Dut1_Tenerife_2026();
Golden_Dut1_Tenerife_low();
Golden_Dut1_South_2010();
Weather_Defaults_Unchanged();
Weather_Passed_To_Refraction();
Weather_Zero_Celsius_Is_Used();
Weather_Temperature_Ignored_Without_Set();
Weather_Refraction_Clamped_Output();
]]></ST>
    </Implementation>
    <Method Name="CheckNear" Id="{ed0f85b5-4330-4a9f-9a54-acb32627980f}">
      <Declaration><![CDATA[METHOD PRIVATE CheckNear
VAR_INPUT
	fExpected	: LREAL;
	fActual		: LREAL;
	fDelta		: LREAL;
	sName		: STRING(255);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[AssertEquals_LREAL(Expected := fExpected, Actual := fActual, Delta := fDelta, Message := sName);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="CheckAngle" Id="{7acc6d9f-7fd9-4f0c-a1b2-cfded46ccff0}">
      <Declaration><![CDATA[METHOD PRIVATE CheckAngle
VAR_INPUT
	fExpected	: LREAL;
	fActual		: LREAL;
	fDelta		: LREAL;
	sName		: STRING(255);
END_VAR
VAR
	fDiff	: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// angles in degrees, compared modulo 360 so that 359.9999999 and -1.0E-7 are equal
fDiff := fActual - fExpected;
WHILE fDiff > 180.0 DO fDiff := fDiff - 360.0; END_WHILE
WHILE fDiff < -180.0 DO fDiff := fDiff + 360.0; END_WHILE
AssertEquals_LREAL(Expected := 0.0, Actual := fDiff, Delta := fDelta, Message := sName);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Golden_All_Corrections_Tenerife_2026" Id="{77618858-d85a-4ba9-95e3-3d70c4d39e1c}">
      <Declaration><![CDATA[METHOD PRIVATE Golden_All_Corrections_Tenerife_2026
VAR
	fb	: AstroBROT.FB_EQ2HOR;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Golden_All_Corrections_Tenerife_2026');
fb(ra := 83.63, dec := 22.01, jd := 2461300.75, lon := -16.5, lat := 28.3, refract := FALSE);
CheckNear(75.59846498223517, fb.alt, 1.0E-7, 'Tenerife_2026 alt');
CheckAngle(112.59057933299366, fb.az, 1.0E-7, 'Tenerife_2026 az');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Golden_All_Corrections_Tenerife_low" Id="{67af639c-9414-4ac8-80a9-75d54aac45e8}">
      <Declaration><![CDATA[METHOD PRIVATE Golden_All_Corrections_Tenerife_low
VAR
	fb	: AstroBROT.FB_EQ2HOR;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Golden_All_Corrections_Tenerife_low');
fb(ra := 130.0, dec := -10.0, jd := 2461300.75, lon := -16.5, lat := 28.3, refract := FALSE);
CheckNear(20.004849547711906, fb.alt, 1.0E-7, 'Tenerife_low alt');
CheckAngle(114.06814750558047, fb.az, 1.0E-7, 'Tenerife_low az');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
