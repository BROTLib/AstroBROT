    </Method>
    <Method Name="Golden_Dut1_South_2010" Id="{84a2e0c7-88e1-4c1b-a34a-3b892a732dea}">
      <Declaration><![CDATA[METHOD PRIVATE Golden_Dut1_South_2010
VAR
	fb	: AstroBROT.FB_EQ2HOR;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Golden_Dut1_South_2010');
fb(ra := 312.5, dec := -47.3, jd := 2455197.5, lon := -70.7, lat := -30.2, refract := FALSE, dut1 := 0.9);
