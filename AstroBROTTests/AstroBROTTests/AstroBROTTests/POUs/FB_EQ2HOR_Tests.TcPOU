CheckAngle(229.80793288979396, fbGeo.az, 1.0E-7, 'South_2010 to geometric az');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Golden_Dut1_Tenerife_2026" Id="{a16a35cb-29a3-4440-92a1-3abf2a17dc95}">
      <Declaration><![CDATA[METHOD PRIVATE Golden_Dut1_Tenerife_2026
VAR
	fb	: AstroBROT.FB_EQ2HOR;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Golden_Dut1_Tenerife_2026');
fb(ra := 83.63, dec := 22.01, jd := 2461300.75, lon := -16.5, lat := 28.3, refract := FALSE, dut1 := 0.9);
CheckNear(75.6015217605425, fb.alt, 1.0E-7, 'Tenerife_2026 dut1 +0.9 alt');
CheckAngle(112.59731630906032, fb.az, 1.0E-7, 'Tenerife_2026 dut1 +0.9 az');
fb(ra := 83.63, dec := 22.01, jd := 2461300.75, lon := -16.5, lat := 28.3, refract := FALSE, dut1 := -0.9);
CheckNear(75.5954080544077, fb.alt, 1.0E-7, 'Tenerife_2026 dut1 -0.9 alt');
CheckAngle(112.58384485334773, fb.az, 1.0E-7, 'Tenerife_2026 dut1 -0.9 az');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Golden_Dut1_Tenerife_low" Id="{58c92258-fcbb-4de1-aaa6-a4d48118dcd7}">
      <Declaration><![CDATA[METHOD PRIVATE Golden_Dut1_Tenerife_low
VAR
