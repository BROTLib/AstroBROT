    <Method Name="Golden_Equinox_And_Solstice_2026" Id="{96178e92-4e92-57e4-8dd7-913f9b338974}">
      <Declaration><![CDATA[METHOD PRIVATE Golden_Equinox_And_Solstice_2026
VAR
	fb	: AstroBROT.FB_SUNPOS;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Golden_Equinox_And_Solstice_2026');
fb(jd := 2461120.5);
CheckAngle(0.3503559250411667, fb.ra, 1.0E-7, 'March_equinox_2026 ra');
CheckNear(0.15188894029624206, fb.dec, 1.0E-7, 'March_equinox_2026 dec');
CheckNear(0.3857660381664108, fb.longmed, 1.0E-7, 'March_equinox_2026 longmed');
CheckNear(23.438239257244735, fb.oblt, 1.0E-7, 'March_equinox_2026 oblt');
CheckSeparation(0.35013805050580776, 0.15179565874940165, fb.ra, fb.dec, 0.0015, 'March_equinox_2026 vs erfa');
fb(jd := 2461212.5);
CheckAngle(89.63389115907498, fb.ra, 1.0E-7, 'June_solstice_2026 ra');
CheckNear(23.437689690338015, fb.dec, 1.0E-7, 'June_solstice_2026 dec');
CheckNear(89.66763149502222, fb.longmed, 1.0E-7, 'June_solstice_2026 longmed');
CheckNear(23.43811655330089, fb.oblt, 1.0E-7, 'June_solstice_2026 oblt');
CheckSeparation(89.63460394632473, 23.437550528896672, fb.ra, fb.dec, 0.0015, 'June_solstice_2026 vs erfa');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Sanity_Equinox_Solstice_Obliquity" Id="{11c5d72b-7ff4-509c-a04f-41e2a68a7249}">
      <Declaration><![CDATA[METHOD PRIVATE Sanity_Equinox_Solstice_Obliquity
VAR
	fb	: AstroBROT.FB_SUNPOS;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Sanity_Equinox_Solstice_Obliquity');
// 2026-03-21 00:00 UT is 9 h after the March equinox: the Sun is at RA about 0.35 deg, Dec about +0.15 deg
fb(jd := 2461120.5);
CheckAngle(0.35, fb.ra, 0.3, 'March equinox ra');
CheckNear(0.15, fb.dec, 0.1, 'March equinox dec');
// 2026-06-21 00:00 UT is 8 h before the June solstice: Dec is at its maximum, RA about 89.6 deg
fb(jd := 2461212.5);
CheckNear(23.44, fb.dec, 0.02, 'June solstice dec');
CheckAngle(89.6, fb.ra, 0.3, 'June solstice ra');
// true obliquity of the ecliptic in 2026
CheckNear(23.437, fb.oblt, 0.005, 'oblt 2026');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Sanity_Right_Ascension_Advances_About_One_Degree_Per_Day" Id="{c3440e0f-4170-5c24-a36f-cd561b32813a}">
      <Declaration><![CDATA[METHOD PRIVATE Sanity_Right_Ascension_Advances_About_One_Degree_Per_Day
VAR
	fb	: AstroBROT.FB_SUNPOS;
	fbNext	: AstroBROT.FB_SUNPOS;
	i	: INT;
	fStep	: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Sanity_Right_Ascension_Advances_About_One_Degree_Per_Day');
// over a year the daily change of RA is between 0.85 and 1.15 deg (0.91 to 1.11 in reality); this also crosses the wrap at 360
FOR i := 0 TO 36 DO
	fb(jd := 2461041.5 + 10.0 * i);
	fbNext(jd := 2461042.5 + 10.0 * i);
	fStep := fbNext.ra - fb.ra;
	IF fStep < 0.0 THEN fStep := fStep + 360.0; END_IF
	AssertTrue(Condition := fStep > 0.85 AND fStep < 1.15, Message := 'daily RA step within 0.85 .. 1.15 deg');
	AssertTrue(Condition := fb.ra >= 0.0 AND fb.ra < 360.0 AND ABS(fb.dec) < 23.5, Message := 'ra in range, |dec| below the obliquity');
END_FOR
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Inputs_Are_Not_Modified" Id="{33f65d12-80f6-5ee1-8fb7-9afeab0a7580}">
      <Declaration><![CDATA[METHOD PRIVATE Inputs_Are_Not_Modified
VAR
	fb	: AstroBROT.FB_SUNPOS;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Inputs_Are_Not_Modified');
fb(jd := 2461300.75);
CheckNear(2461300.75, fb.jd, 0.0, 'jd unchanged');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Cyclic_Calls_With_Inputs_Set_Once_Are_Stable" Id="{3be82c5d-3cef-53f3-a617-a182a53e24a5}">
      <Declaration><![CDATA[METHOD PRIVATE Cyclic_Calls_With_Inputs_Set_Once_Are_Stable
VAR
	fb	: AstroBROT.FB_SUNPOS;
	i	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Cyclic_Calls_With_Inputs_Set_Once_Are_Stable');
fb.jd := 2461300.75;
FOR i := 1 TO 5 DO
	fb();
	CheckAngle(174.8393337772982, fb.ra, 1.0E-7, 'cyclic call ra');
	CheckNear(2.2331274030840897, fb.dec, 1.0E-7, 'cyclic call dec');
END_FOR
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
