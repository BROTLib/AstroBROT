    <Method Name="Right_Ascension_Is_Periodic" Id="{630c859c-0151-5c52-8af6-f13b5c6be800}">
      <Declaration><![CDATA[METHOD PRIVATE Right_Ascension_Is_Periodic
VAR
	fb	: AstroBROT.FB_RADEC2HADEC;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Right_Ascension_Is_Periodic');
// ra and ra +- 360 are the same position
fb(jd := 2461300.75, ra := -276.37, dec := 22.01, lon := -16.5);
CheckAngle(345.6575630310487, fb.ha_out, 1.0E-9, 'ra - 360 ha');
CheckNear(22.02849232968123, fb.dec_out, 1.0E-9, 'ra - 360 dec');
fb(jd := 2461300.75, ra := 443.63, dec := 22.01, lon := -16.5);
CheckAngle(345.6575630310487, fb.ha_out, 1.0E-9, 'ra + 360 ha');
CheckNear(22.02849232968123, fb.dec_out, 1.0E-9, 'ra + 360 dec');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Longitude_Is_Periodic" Id="{6721f928-dce0-54b5-9ec3-99fa33cf5532}">
      <Declaration><![CDATA[METHOD PRIVATE Longitude_Is_Periodic
VAR
	fb	: AstroBROT.FB_RADEC2HADEC;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Longitude_Is_Periodic');
// lon and lon +- 360 are the same place
fb(jd := 2461300.75, ra := 83.63, dec := 22.01, lon := 343.5);
CheckAngle(345.6575630310487, fb.ha_out, 1.0E-9, 'lon + 360 ha');
fb(jd := 2461300.75, ra := 83.63, dec := 22.01, lon := -376.5);
CheckAngle(345.6575630310487, fb.ha_out, 1.0E-9, 'lon - 360 ha');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Outputs_Stay_In_Range" Id="{180e42aa-f9c3-5697-8eaa-001a29a46c42}">
      <Declaration><![CDATA[METHOD PRIVATE Outputs_Stay_In_Range
VAR
	fb	: AstroBROT.FB_RADEC2HADEC;
	i	: INT;
	fRa	: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Outputs_Stay_In_Range');
// a sweep over the whole RA circle and the declinations up to and including the poles
FOR i := 0 TO 8 DO
	fRa := 45.0 * i;
	fb(jd := 2461300.75, ra := fRa, dec := 90.0, lon := -16.5);
	AssertTrue(Condition := fb.ha_out >= 0.0 AND fb.ha_out < 360.0 AND fb.dec_out <= 90.0 AND fb.dec_out >= -90.0, Message := 'ra sweep at dec +90 stays in range');
	fb(jd := 2461300.75, ra := fRa, dec := -90.0, lon := -16.5);
	AssertTrue(Condition := fb.ha_out >= 0.0 AND fb.ha_out < 360.0 AND fb.dec_out <= 90.0 AND fb.dec_out >= -90.0, Message := 'ra sweep at dec -90 stays in range');
	fb(jd := 2461300.75, ra := fRa, dec := 0.0, lon := -16.5);
	AssertTrue(Condition := fb.ha_out >= 0.0 AND fb.ha_out < 360.0 AND fb.dec_out <= 90.0 AND fb.dec_out >= -90.0, Message := 'ra sweep at dec 0 stays in range');
END_FOR
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Time_Inputs_Are_Not_Modified" Id="{2dde0a0e-4033-542e-a641-d61f54ee417c}">
      <Declaration><![CDATA[METHOD PRIVATE Time_Inputs_Are_Not_Modified
VAR
	fb	: AstroBROT.FB_RADEC2HADEC;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Time_Inputs_Are_Not_Modified');
fb(jd := 2461300.75, ra := 83.63, dec := 22.01, lon := -16.5, dut1 := 0.5);
CheckNear(2461300.75, fb.jd, 0.0, 'jd unchanged');
CheckNear(-16.5, fb.lon, 0.0, 'lon unchanged');
CheckNear(0.5, fb.dut1, 0.0, 'dut1 unchanged');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
