    <Method Name="Golden_Near_The_Poles" Id="{b8533e73-d348-59d1-81c1-e5299d6e1d1c}">
      <Declaration><![CDATA[METHOD PRIVATE Golden_Near_The_Poles
VAR
	fb	: AstroBROT.FB_HADEC2RADEC;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Golden_Near_The_Poles');
fb(jd := 2461300.75, ha := 200.0, dec := 89.9, lon := -16.5, dut1 := 0.0);
CheckAngle(316.7079065490832, fb.ra_out, 1.0E-7, 'Near_north_pole ra');
