    <Method Name="Golden_Exact_Poles" Id="{ed7ba411-c41c-5e83-b644-ac35d6995366}">
      <Declaration><![CDATA[METHOD PRIVATE Golden_Exact_Poles
VAR
	fb	: AstroBROT.FB_HADEC2RADEC;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Golden_Exact_Poles');
fb(jd := 2461300.75, ha := 200.0, dec := 90.0, lon := -16.5, dut1 := 0.0);
// at exactly dec = +-90 neither ra nor dec is reproducible (d_ra ~ 1/cos(dec) = 1E16, and d_dec is evaluated at that ra), only the bound against erfa is pinned
CheckSeparation(358.71048545509177, 89.85071696591022, fb.ra_out, fb.dec_out, 0.015, 'North_pole vs erfa');
fb(jd := 2455197.5, ha := 200.0, dec := -90.0, lon := -70.7, dut1 := 0.0);
// at exactly dec = +-90 neither ra nor dec is reproducible (d_ra ~ 1/cos(dec) = 1E16, and d_dec is evaluated at that ra), only the bound against erfa is pinned
CheckSeparation(179.80951066897055, -89.94824466951559, fb.ra_out, fb.dec_out, 0.015, 'South_pole vs erfa');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Hour_Angle_Is_Periodic" Id="{6b513f48-ffc4-51ef-b615-38ae7ade21f3}">
      <Declaration><![CDATA[METHOD PRIVATE Hour_Angle_Is_Periodic
VAR
	fb	: AstroBROT.FB_HADEC2RADEC;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Hour_Angle_Is_Periodic');
// ha and ha +- 360 are the same position; the block does not wrap ra before the corrections, so this also covers the wrap of d_ra (issue #10)
fb(jd := 2461300.75, ha := -15.0, dec := 22.01, lon := -16.5);
CheckAngle(84.28759958479777, fb.ra_out, 1.0E-9, 'ha - 360 ra');
CheckNear(21.993212482320583, fb.dec_out, 1.0E-9, 'ha - 360 dec');
fb(jd := 2461300.75, ha := 705.0, dec := 22.01, lon := -16.5);
CheckAngle(84.28759958479777, fb.ra_out, 1.0E-9, 'ha + 360 ra');
CheckNear(21.993212482320583, fb.dec_out, 1.0E-9, 'ha + 360 dec');
AssertTrue(Condition := fb.ra_out >= 0.0 AND fb.ra_out < 360.0, Message := 'ra_out is within 0 <= ra < 360');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Longitude_Is_Periodic" Id="{0847667b-b68c-57b4-8bc1-ba794e99dcb4}">
      <Declaration><![CDATA[METHOD PRIVATE Longitude_Is_Periodic
VAR
	fb	: AstroBROT.FB_HADEC2RADEC;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Longitude_Is_Periodic');
fb(jd := 2461300.75, ha := 345.0, dec := 22.01, lon := 343.5);
CheckAngle(84.28759958479777, fb.ra_out, 1.0E-9, 'lon + 360 ra');
fb(jd := 2461300.75, ha := 345.0, dec := 22.01, lon := -376.5);
CheckAngle(84.28759958479777, fb.ra_out, 1.0E-9, 'lon - 360 ra');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Outputs_Stay_In_Range" Id="{a8091054-9d20-565d-957d-3b81986f2485}">
      <Declaration><![CDATA[METHOD PRIVATE Outputs_Stay_In_Range
VAR
	fb	: AstroBROT.FB_HADEC2RADEC;
	i	: INT;
	fHa	: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Outputs_Stay_In_Range');
FOR i := -1 TO 8 DO
	fHa := 45.0 * i;
	fb(jd := 2461300.75, ha := fHa, dec := 89.9, lon := -16.5);
	AssertTrue(Condition := fb.ra_out >= 0.0 AND fb.ra_out < 360.0 AND fb.dec_out <= 90.0 AND fb.dec_out >= -90.0, Message := 'ha sweep at dec +89.9 stays in range');
	fb(jd := 2461300.75, ha := fHa, dec := -89.9, lon := -16.5);
	AssertTrue(Condition := fb.ra_out >= 0.0 AND fb.ra_out < 360.0 AND fb.dec_out <= 90.0 AND fb.dec_out >= -90.0, Message := 'ha sweep at dec -89.9 stays in range');
	fb(jd := 2461300.75, ha := fHa, dec := 0.0, lon := -16.5);
	AssertTrue(Condition := fb.ra_out >= 0.0 AND fb.ra_out < 360.0 AND fb.dec_out <= 90.0 AND fb.dec_out >= -90.0, Message := 'ha sweep at dec 0 stays in range');
END_FOR
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Round_Trip_Through_RADEC2HADEC" Id="{e58622d7-be22-5cc5-9f05-d2a3183d87a3}">
      <Declaration><![CDATA[METHOD PRIVATE Round_Trip_Through_RADEC2HADEC
VAR
	fbFwd	: AstroBROT.FB_RADEC2HADEC;
	fbBack	: AstroBROT.FB_HADEC2RADEC;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Round_Trip_Through_RADEC2HADEC');
// the two blocks are only approximate inverses (nutation and aberration are applied at slightly different
// positions), so 1E-6 deg away from the poles and 2E-4 deg (0.72 arcsec) 0.1 deg from a pole
fbFwd(jd := 2461300.75, ra := 83.63, dec := 22.01, lon := -16.5);
fbBack(jd := 2461300.75, ha := fbFwd.ha_out, dec := fbFwd.dec_out, lon := -16.5);
CheckSeparation(83.63, 22.01, fbBack.ra_out, fbBack.dec_out, 1.0E-6, 'Tenerife_2026');
fbFwd(jd := 2455197.5, ra := 312.5, dec := -47.3, lon := -70.7);
fbBack(jd := 2455197.5, ha := fbFwd.ha_out, dec := fbFwd.dec_out, lon := -70.7);
CheckSeparation(312.5, -47.3, fbBack.ra_out, fbBack.dec_out, 1.0E-6, 'South_2010');
fbFwd(jd := 2461300.75, ra := 359.9999, dec := 22.01, lon := -16.5);
fbBack(jd := 2461300.75, ha := fbFwd.ha_out, dec := fbFwd.dec_out, lon := -16.5);
CheckSeparation(359.9999, 22.01, fbBack.ra_out, fbBack.dec_out, 1.0E-6, 'RA just below 360');
fbFwd(jd := 2461300.75, ra := 0.0001, dec := 22.01, lon := -16.5);
fbBack(jd := 2461300.75, ha := fbFwd.ha_out, dec := fbFwd.dec_out, lon := -16.5);
CheckSeparation(0.0001, 22.01, fbBack.ra_out, fbBack.dec_out, 1.0E-6, 'RA just above 0');
fbFwd(jd := 2461300.75, ra := 200.0, dec := 89.9, lon := -16.5);
fbBack(jd := 2461300.75, ha := fbFwd.ha_out, dec := fbFwd.dec_out, lon := -16.5);
CheckSeparation(200.0, 89.9, fbBack.ra_out, fbBack.dec_out, 0.0002, 'near the north pole');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Inputs_Are_Not_Modified" Id="{da5f922f-32bf-578b-b880-d28443b770be}">
      <Declaration><![CDATA[METHOD PRIVATE Inputs_Are_Not_Modified
VAR
	fb	: AstroBROT.FB_HADEC2RADEC;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Inputs_Are_Not_Modified');
fb(jd := 2461300.75, ha := 345.0, dec := 22.01, lon := -16.5, dut1 := 0.5);
CheckNear(2461300.75, fb.jd, 0.0, 'jd unchanged');
CheckNear(345.0, fb.ha, 0.0, 'ha unchanged');
CheckNear(22.01, fb.dec, 0.0, 'dec unchanged');
CheckNear(-16.5, fb.lon, 0.0, 'lon unchanged');
CheckNear(0.5, fb.dut1, 0.0, 'dut1 unchanged');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Cyclic_Calls_With_Inputs_Set_Once_Are_Stable" Id="{894e2f06-00a0-5f17-a4f7-92369f0c7a4a}">
      <Declaration><![CDATA[METHOD PRIVATE Cyclic_Calls_With_Inputs_Set_Once_Are_Stable
VAR
	fb	: AstroBROT.FB_HADEC2RADEC;
	i	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Cyclic_Calls_With_Inputs_Set_Once_Are_Stable');
fb.jd := 2461300.75;
fb.ha := 345.0;
fb.dec := 22.01;
fb.lon := -16.5;
FOR i := 1 TO 5 DO
	fb();
	CheckAngle(84.28759958479777, fb.ra_out, 1.0E-7, 'cyclic call ra');
	CheckNear(21.993212482320583, fb.dec_out, 1.0E-7, 'cyclic call dec');
END_FOR
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
