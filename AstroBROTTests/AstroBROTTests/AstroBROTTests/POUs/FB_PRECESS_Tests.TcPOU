<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_PRECESS_Tests" Id="{c4f9e834-229f-5470-8bb2-0bbad94582b1}" SpecialFunc="None">
    <Declaration><![CDATA[// Tests for AstroBROT.FB_PRECESS (P03 precession between two Julian epochs, via J2000).
//
// GENERATED by AstroBROT/testing/gen_block_tests.py from testing/golden_blocks.py, do not edit the numbers by hand.
// Every golden case is checked twice: against the Python port of the ST (tolerance 1E-8 deg, catches any change of
// behaviour) and against erfa.bp06 (precession matrix, great-circle separation 1E-5 deg = 0.036 arcsec, catches an
// error the port shares with the ST). The relation tests do not need golden values at all.
//
// FB_PRECESS only rotates between J2000 and one other epoch, so a general epoch pair goes through J2000 (issue #9).
FUNCTION_BLOCK FB_PRECESS_Tests EXTENDS TcUnit.FB_TestSuite
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Golden_J2000_To_Date();
Golden_Between_Two_Epochs();
Golden_RA_Wrap();
Golden_Poles();
Same_Epoch_Is_Identity();
Round_Trip_Through_J2000();
Two_Steps_Equal_Precessing_Via_J2000();
Right_Ascension_Is_Normalised();
Inputs_Are_Not_Modified();
Cyclic_Calls_With_Inputs_Set_Once_Are_Stable();
]]></ST>
    </Implementation>
    <Method Name="CheckNear" Id="{f59c2d20-9a75-53e0-93a7-4941e5656881}">
      <Declaration><![CDATA[METHOD PRIVATE CheckNear
VAR_INPUT
	fExpected	: LREAL;
	fActual	: LREAL;
	fDelta	: LREAL;
	sName	: STRING(255);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[AssertEquals_LREAL(Expected := fExpected, Actual := fActual, Delta := fDelta, Message := sName);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="CheckAngle" Id="{fe16029c-4b61-591c-873c-181cff311bc8}">
      <Declaration><![CDATA[METHOD PRIVATE CheckAngle
VAR_INPUT
	fExpected	: LREAL;
	fActual	: LREAL;
	fDelta	: LREAL;
	sName	: STRING(255);
END_VAR
VAR
	fDiff	: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// angles in degrees, compared modulo 360 so that 359.9999999 and -1.0E-7 are equal
fDiff := fActual - fExpected;
WHILE fDiff > 180.0 DO fDiff := fDiff - 360.0; END_WHILE
WHILE fDiff < -180.0 DO fDiff := fDiff + 360.0; END_WHILE
AssertEquals_LREAL(Expected := 0.0, Actual := fDiff, Delta := fDelta, Message := sName);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="CheckSeparation" Id="{dfed3a61-3fc9-5138-bc71-a10550b422ae}">
      <Declaration><![CDATA[METHOD PRIVATE CheckSeparation
VAR_INPUT
	fLon1	: LREAL;
	fLat1	: LREAL;
	fLon2	: LREAL;
	fLat2	: LREAL;
	fDelta	: LREAL;
	sName	: STRING(255);
END_VAR
VAR
	fD2r	: LREAL;
	fHalfDLat	: LREAL;
	fHalfDLon	: LREAL;
	fHav	: LREAL;
	fSep	: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// great-circle separation of two positions (longitude, latitude in degrees) against a tolerance in degrees;
// a difference of longitudes is not a distance on the sky, this is (haversine formula)
fD2r := 0.017453292519943295;
fHalfDLat := (fLat2 - fLat1) * fD2r * 0.5;
fHalfDLon := (fLon2 - fLon1) * fD2r * 0.5;
fHav := SIN(fHalfDLat) * SIN(fHalfDLat) + COS(fLat1 * fD2r) * COS(fLat2 * fD2r) * SIN(fHalfDLon) * SIN(fHalfDLon);
fSep := 2.0 * ASIN(SQRT(LIMIT(0.0, fHav, 1.0))) / fD2r;
AssertEquals_LREAL(Expected := 0.0, Actual := fSep, Delta := fDelta, Message := sName);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Golden_J2000_To_Date" Id="{97870b34-44ee-5631-80c4-7d5dc130d957}">
      <Declaration><![CDATA[METHOD PRIVATE Golden_J2000_To_Date
VAR
	fb	: AstroBROT.FB_PRECESS;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Golden_J2000_To_Date');
fb(ra := 83.63, dec := 22.01, equinox1 := 2000.0, equinox2 := 2026.5);
CheckAngle(84.02884460749144, fb.ra_precessed, 1.0E-8, 'J2000_to_2026 ra');
CheckNear(22.0258551337181, fb.dec_precessed, 1.0E-8, 'J2000_to_2026 dec');
CheckSeparation(84.02884460749591, 22.025855133729486, fb.ra_precessed, fb.dec_precessed, 1.0E-5, 'J2000_to_2026 vs erfa');
fb(ra := 312.5, dec := -47.3, equinox1 := 2000.0, equinox2 := 2010.0);
CheckAngle(312.6725080638107, fb.ra_precessed, 1.0E-8, 'J2000_to_2010_south ra');
CheckNear(-47.262327080321406, fb.dec_precessed, 1.0E-8, 'J2000_to_2010_south dec');
CheckSeparation(312.6725080638149, -47.26232708032657, fb.ra_precessed, fb.dec_precessed, 1.0E-5, 'J2000_to_2010_south vs erfa');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Golden_Between_Two_Epochs" Id="{ab8c7f13-0e22-59c8-80c2-1bb62dcf8e31}">
      <Declaration><![CDATA[METHOD PRIVATE Golden_Between_Two_Epochs
VAR
	fb	: AstroBROT.FB_PRECESS;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Golden_Between_Two_Epochs');
fb(ra := 10.0, dec := 20.0, equinox1 := 2010.0, equinox2 := 2020.0);
CheckAngle(10.131674024998764, fb.ra_precessed, 1.0E-8, 'Both_epochs_not_J2000 ra');
CheckNear(20.054811409601943, fb.dec_precessed, 1.0E-8, 'Both_epochs_not_J2000 dec');
CheckSeparation(10.13167402499991, 20.05481140959979, fb.ra_precessed, fb.dec_precessed, 1.0E-5, 'Both_epochs_not_J2000 vs erfa');
fb(ra := 10.0, dec := 20.0, equinox1 := 2020.0, equinox2 := 2000.0);
CheckAngle(9.736828222801343, fb.ra_precessed, 1.0E-8, 'Back_to_J2000 ra');
CheckNear(19.890308491600006, fb.dec_precessed, 1.0E-8, 'Back_to_J2000 dec');
CheckSeparation(9.73682822279856, 19.890308491604287, fb.ra_precessed, fb.dec_precessed, 1.0E-5, 'Back_to_J2000 vs erfa');
fb(ra := 200.0, dec := -30.0, equinox1 := 1950.0, equinox2 := 2000.0);
CheckAngle(200.69666810482232, fb.ra_precessed, 1.0E-8, 'From_1950 ra');
CheckNear(-30.261014690476078, fb.dec_precessed, 1.0E-8, 'From_1950 dec');
CheckSeparation(200.69666810483287, -30.26101469046997, fb.ra_precessed, fb.dec_precessed, 1.0E-5, 'From_1950 vs erfa');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Golden_RA_Wrap" Id="{2c32a216-27bf-5260-af29-5b20325d9bb3}">
      <Declaration><![CDATA[METHOD PRIVATE Golden_RA_Wrap
VAR
	fb	: AstroBROT.FB_PRECESS;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Golden_RA_Wrap');
fb(ra := 359.9999, dec := 10.0, equinox1 := 2000.0, equinox2 := 2050.0);
CheckAngle(0.6408546660457171, fb.ra_precessed, 1.0E-8, 'RA_wrap_up ra');
CheckNear(10.278324337869142, fb.dec_precessed, 1.0E-8, 'RA_wrap_up dec');
CheckSeparation(0.6408546660547558, 10.2783243378534, fb.ra_precessed, fb.dec_precessed, 1.0E-5, 'RA_wrap_up vs erfa');
fb(ra := 0.0001, dec := 10.0, equinox1 := 2000.0, equinox2 := 1950.0);
CheckAngle(359.3598872118728, fb.ra_precessed, 1.0E-8, 'RA_wrap_down ra');
CheckNear(9.721615962410127, fb.dec_precessed, 1.0E-8, 'RA_wrap_down dec');
CheckSeparation(359.35988721185373, 9.72161596242269, fb.ra_precessed, fb.dec_precessed, 1.0E-5, 'RA_wrap_down vs erfa');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Golden_Poles" Id="{7b28e292-9262-512e-86bf-76271bb8fb75}">
      <Declaration><![CDATA[METHOD PRIVATE Golden_Poles
VAR
	fb	: AstroBROT.FB_PRECESS;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Golden_Poles');
fb(ra := 0.0, dec := 90.0, equinox1 := 2000.0, equinox2 := 2030.0);
CheckAngle(180.19146429912647, fb.ra_precessed, 1.0E-8, 'North_pole ra');
CheckNear(89.83299505910631, fb.dec_precessed, 1.0E-8, 'North_pole dec');
CheckSeparation(180.1914643039869, 89.83299505911724, fb.ra_precessed, fb.dec_precessed, 1.0E-5, 'North_pole vs erfa');
fb(ra := 0.0, dec := -90.0, equinox1 := 2000.0, equinox2 := 2030.0);
CheckAngle(0.1914642991264698, fb.ra_precessed, 1.0E-8, 'South_pole ra');
CheckNear(-89.83299505910631, fb.dec_precessed, 1.0E-8, 'South_pole dec');
CheckSeparation(0.19146430398690156, -89.83299505911724, fb.ra_precessed, fb.dec_precessed, 1.0E-5, 'South_pole vs erfa');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Same_Epoch_Is_Identity" Id="{cb84dea8-08bf-5176-94e2-286426349089}">
      <Declaration><![CDATA[METHOD PRIVATE Same_Epoch_Is_Identity
VAR
	fb	: AstroBROT.FB_PRECESS;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Same_Epoch_Is_Identity');
fb(ra := 123.4, dec := -56.7, equinox1 := 2015.0, equinox2 := 2015.0);
CheckAngle(123.4, fb.ra_precessed, 1.0E-12, 'ra');
CheckNear(-56.7, fb.dec_precessed, 1.0E-12, 'dec');
fb(ra := 123.4, dec := -56.7, equinox1 := 2000.0, equinox2 := 2000.0);
CheckAngle(123.4, fb.ra_precessed, 1.0E-12, 'J2000 ra');
CheckNear(-56.7, fb.dec_precessed, 1.0E-12, 'J2000 dec');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Round_Trip_Through_J2000" Id="{b3e9e3a0-9d43-5357-9059-bc6e2ce20d38}">
      <Declaration><![CDATA[METHOD PRIVATE Round_Trip_Through_J2000
VAR
	fb	: AstroBROT.FB_PRECESS;
	fbBack	: AstroBROT.FB_PRECESS;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Round_Trip_Through_J2000');
fb(ra := 83.63, dec := 22.01, equinox1 := 2000.0, equinox2 := 2050.0);
fbBack(ra := fb.ra_precessed, dec := fb.dec_precessed, equinox1 := 2050.0, equinox2 := 2000.0);
CheckAngle(83.63, fbBack.ra_precessed, 1.0E-9, 'J2000 -> 2050 -> J2000 ra');
CheckNear(22.01, fbBack.dec_precessed, 1.0E-9, 'J2000 -> 2050 -> J2000 dec');
fb(ra := 10.0, dec := 20.0, equinox1 := 2010.0, equinox2 := 2030.0);
fbBack(ra := fb.ra_precessed, dec := fb.dec_precessed, equinox1 := 2030.0, equinox2 := 2010.0);
CheckAngle(10.0, fbBack.ra_precessed, 1.0E-9, '2010 -> 2030 -> 2010 ra');
CheckNear(20.0, fbBack.dec_precessed, 1.0E-9, '2010 -> 2030 -> 2010 dec');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Two_Steps_Equal_Precessing_Via_J2000" Id="{9399f809-5d36-5578-bc3c-f7167d5936a0}">
      <Declaration><![CDATA[METHOD PRIVATE Two_Steps_Equal_Precessing_Via_J2000
VAR
	fb	: AstroBROT.FB_PRECESS;
	fbA	: AstroBROT.FB_PRECESS;
	fbB	: AstroBROT.FB_PRECESS;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Two_Steps_Equal_Precessing_Via_J2000');
// before the fix of issue #9 a step between two epochs that are both not J2000 gave the wrong result
fb(ra := 10.0, dec := 20.0, equinox1 := 2010.0, equinox2 := 2020.0);
fbA(ra := 10.0, dec := 20.0, equinox1 := 2010.0, equinox2 := 2000.0);
fbB(ra := fbA.ra_precessed, dec := fbA.dec_precessed, equinox1 := 2000.0, equinox2 := 2020.0);
CheckAngle(fbB.ra_precessed, fb.ra_precessed, 1.0E-9, 'ra');
CheckNear(fbB.dec_precessed, fb.dec_precessed, 1.0E-9, 'dec');
// and 2010 -> 2020 is not the same rotation as 2000 -> 2010
fbA(ra := 10.0, dec := 20.0, equinox1 := 2000.0, equinox2 := 2010.0);
AssertTrue(Condition := ABS(fb.ra_precessed - fbA.ra_precessed) > 1.0E-6, Message := 'shifted epochs give a different result');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Right_Ascension_Is_Normalised" Id="{3965057b-85fc-5247-b1db-61b452700d1e}">
      <Declaration><![CDATA[METHOD PRIVATE Right_Ascension_Is_Normalised
VAR
	fb	: AstroBROT.FB_PRECESS;
	fbRef	: AstroBROT.FB_PRECESS;
	fbShift	: AstroBROT.FB_PRECESS;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Right_Ascension_Is_Normalised');
fbRef(ra := 350.0, dec := -40.0, equinox1 := 2000.0, equinox2 := 2030.0);
fb(ra := -10.0, dec := -40.0, equinox1 := 2000.0, equinox2 := 2030.0);
CheckAngle(fbRef.ra_precessed, fb.ra_precessed, 1.0E-9, 'ra -10 is 350');
AssertTrue(Condition := fb.ra_precessed >= 0.0 AND fb.ra_precessed < 360.0, Message := 'ra -10 gives 0 <= ra < 360');
fbShift(ra := 710.0, dec := -40.0, equinox1 := 2000.0, equinox2 := 2030.0);
CheckAngle(fbRef.ra_precessed, fbShift.ra_precessed, 1.0E-9, 'ra 710 is 350');
AssertTrue(Condition := fbShift.ra_precessed >= 0.0 AND fbShift.ra_precessed < 360.0, Message := 'ra 710 gives 0 <= ra < 360');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Inputs_Are_Not_Modified" Id="{7cfd4f9b-a77d-5324-b9d6-d093b80c8b61}">
      <Declaration><![CDATA[METHOD PRIVATE Inputs_Are_Not_Modified
VAR
	fb	: AstroBROT.FB_PRECESS;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Inputs_Are_Not_Modified');
fb(ra := 83.63, dec := 22.01, equinox1 := 2000.0, equinox2 := 2026.5);
CheckNear(83.63, fb.ra, 1.0E-15, 'ra unchanged');
CheckNear(22.01, fb.dec, 1.0E-15, 'dec unchanged');
CheckNear(2000.0, fb.equinox1, 1.0E-15, 'equinox1 unchanged');
CheckNear(2026.5, fb.equinox2, 1.0E-15, 'equinox2 unchanged');
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Cyclic_Calls_With_Inputs_Set_Once_Are_Stable" Id="{ab7b98ef-a6c8-5215-9f5e-f9d489e6a8f7}">
      <Declaration><![CDATA[METHOD PRIVATE Cyclic_Calls_With_Inputs_Set_Once_Are_Stable
VAR
	fb	: AstroBROT.FB_PRECESS;
	i	: INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Cyclic_Calls_With_Inputs_Set_Once_Are_Stable');
fb.ra := 83.63;
fb.dec := 22.01;
fb.equinox1 := 2000.0;
fb.equinox2 := 2026.5;
FOR i := 1 TO 5 DO
	fb();
	CheckAngle(84.02884460749144, fb.ra_precessed, 1.0E-8, 'cyclic call ra');
	CheckNear(22.0258551337181, fb.dec_precessed, 1.0E-8, 'cyclic call dec');
END_FOR
TEST_FINISHED();
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
