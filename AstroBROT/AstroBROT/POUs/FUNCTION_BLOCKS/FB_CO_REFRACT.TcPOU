<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_CO_REFRACT" Id="{3da273e0-5aa9-4438-ae19-b4f0ec632a24}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_CO_REFRACT
VAR_INPUT
	old_alt			: LREAL;			// old alt in degrees
	altitude		: LREAL := 0.0;		// altitude of observatory
	pressure		: LREAL := 0.0;		// pressure
	temperature		: LREAL := 0.0;		// ground temperature in degrees Celsius, only used if temperature_set is TRUE
	temperature_set	: BOOL := FALSE;	// TRUE: use temperature (0.0 C is valid), FALSE: estimate it from altitude
	epsilon			: LREAL := 0.25; 	//accuracy of iteration for observed=TRUE case, in arcseconds, values below min_epsilon are raised to min_epsilon
	TO_OBSERVED		: BOOL;
END_VAR
VAR_OUTPUT
	new_alt			: LREAL;
END_VAR
VAR
	aout, P, T, dr, cur, last : LREAL;	// P in millibars, T in degrees Celsius
	eps				: LREAL;			// epsilon after clamping
	n				: INT;				// iterations of the observed=TRUE loop
END_VAR
VAR CONSTANT
	alpha 			: LREAL := 0.0065; 	//temp lapse rate [deg C per meter]
	min_epsilon		: LREAL := 0.001;	//smallest accepted epsilon [arcsec]
	max_iterations	: INT := 10;		//iteration cap, the loop converges in 1 to 5 iterations
	max_abs_alt		: LREAL := 1.0E6;	//old_alt beyond this (or NaN/Inf) is rejected
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// https://github.com/wlandsman/IDLAstro/blob/master/pro/co_refract.pro

// Reject NaN/Inf (the comparisons are FALSE for NaN) and pass old_alt through unchanged,
// otherwise the iteration below could not converge.
IF NOT (old_alt > -max_abs_alt AND old_alt < max_abs_alt) THEN
	new_alt := old_alt;
	RETURN;
END_IF

// The IDL original works in Kelvin, CO_REFRACT_FORWARD expects degrees Celsius,
// so all temperatures here are Celsius (IDL's 283.0 K and 211.5 K minus the 273.0 offset used there).
IF temperature_set THEN
	T := temperature;
ELSIF altitude > 11000.0 THEN 
	T := 211.5 - 273.0; 
ELSE 
	T := 283.0 - 273.0 - alpha*altitude;
END_IF

// estimate Pressure based on altitude, using U.S. Standard Atmosphere formula.
IF pressure = 0 THEN 
	P := 1010.0*EXPT(1-6.5/288000*altitude, 5.255);
ELSE
	P := pressure;
END_IF

IF NOT TO_OBSERVED THEN 
	aout := old_alt - co_refract_forward(old_alt, P:=P, T:=T);
ELSE
	aout := 0.0;
	//calculate initial refraction guess
	dr := co_refract_forward(old_alt, P:=P, T:=T);
	cur := old_alt + dr; // guess of observed location

	// epsilon <= 0 (or NaN) would never satisfy the exit condition, so clamp it and cap the iterations
	IF epsilon > min_epsilon THEN
		eps := epsilon;
	ELSE
		eps := min_epsilon;
	END_IF
	n := 0;
	REPEAT 
	 	last := cur;
		dr := co_refract_forward(cur, P:= P, T:=T);
	  	cur := old_alt + dr;
		n := n + 1;
	UNTIL ABS(last-cur)*3600.0 < eps OR n >= max_iterations
	END_REPEAT
	aout := cur;
END_IF

new_alt := aout;
]]></ST>
    </Implementation>
    <LineIds Name="FB_CO_REFRACT">
      <LineId Id="52" Count="0" />
      <LineId Id="3" Count="56" />
      <LineId Id="2" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>