<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_HADEC2RADEC" Id="{8f7a7748-90e3-4e16-8cf9-41e658f19889}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_HADEC2RADEC
VAR_INPUT
	jd				: LREAL;		// Julian date, UTC time scale
	dut1			: LREAL := 0.0;	// UT1-UTC in seconds (IERS), 0 treats UTC as UT1
	ha				: LREAL;		// Hour angle (APPARENT) in degrees
	dec				: LREAL;		// Declination (APPARENT) in degrees
	lon				: LREAL;		// Longitude in degrees
	precess			: BOOL := TRUE;	// FALSE: no precession correction
	nutate			: BOOL := TRUE;	// FALSE: no nutation correction
	aberration		: BOOL := TRUE;	// FALSE: no aberration correction
END_VAR
VAR_OUTPUT
	ra_out				: LREAL;		// RA in degrees (ICRS)
	dec_out			: LREAL;			// DEC in degrees (ICRS)
END_VAR
VAR
	lmst			: LREAL;
	last			: LREAL;
	d_psi			: LREAL;
	d_eps			: LREAL;
	eps				: LREAL;
	J_now			: LREAL;
	IAU2000B		: FB_IAU2000B;
	fbprecess		: FB_PRECESS;
	co_nutate		: FB_CO_NUTATE;
	co_aberration	: FB_CO_ABERRATION;
	d_ra_abr		: LREAL;		// Difference in RA due to aberration
	d_dec_abr		: LREAL;		// Difference in Dec due to aberration
	d_ra_nut		: LREAL;		// Difference in RA due to nutation
	d_dec_nut		: LREAL;		// Difference in Dec due to nutation
	alt,az			: LREAL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// This code calculates the Right Ascension and Declination (ICRS) from the Hour Angle and Declination (APPARENT)
// This includes P03 precession and IAU2000B nutation as well as aberration (IDL libary)
// adapted from: https://github.com/wlandsman/IDLAstro/blob/master/pro/hor2eq.pro (IDL libary)
// this version is written by Lukas Melzig


// the corrections are only written below if the respective flag is set, so start from zero
// to not keep applying the values of a previous call
d_ra_nut := 0.0;
d_dec_nut := 0.0;
d_ra_abr := 0.0;
d_dec_abr := 0.0;

// must calculate obliquity OF ecliptic
IAU2000B(jd := jd,
		d_psi => d_psi,
		d_eps => d_eps);

eps := JD2OBLIQUITY(jd, d_eps); // TRUE obliquity OF the ecliptic in radians

// Calculate LOCAL MEAN SIDEREAL TIME
lmst := jd2lst(JD:=jd, lon:=lon, dut1:=dut1);
// calculate local APPARENT sidereal time
last := LMST2LAST(lmst, d_psi, eps);

// Find right ascension (in DEGREES)
ra_out := MODABS(last - ha + 360.0, 360.0);
dec_out := dec;
//*****************************************************************************
// calculate NUTATION and ABERRATION Corrections to Ra-Dec
IF nutate THEN
	co_nutate(
		jd := jd,
		ra := ra_out,
		dec := dec_out,
		nut_given := TRUE,
		d_psi_in := d_psi,
		d_eps_in := d_eps,
		d_ra => d_ra_nut,
		d_dec => d_dec_nut);
END_IF

IF aberration THEN
	co_aberration(
		jd := jd,
		ra := ra_out,
		dec := dec_out,
		eps := eps,
		d_ra => d_ra_abr,
		d_dec => d_dec_abr);
END_IF
//apply
ra_out := ra_out - (d_ra_abr + d_ra_nut);
dec_out := dec_out - (d_dec_abr + d_dec_nut);
//*****************************************************************************
//precess back
J_now := JD2JEPOCH(jd); // compute current equinox
IF precess THEN
	fbprecess(
		ra := ra_out,
		dec := dec_out,
		equinox1 := J_now,
		equinox2 := 2000.0,
		ra_precessed => ra_out,
		dec_precessed => dec_out);
ELSE
	// the precession block wraps RA, without it the correction can leave 0 to 360
	ra_out := MODABS(ra_out, 360.0);
END_IF

]]></ST>
    </Implementation>
