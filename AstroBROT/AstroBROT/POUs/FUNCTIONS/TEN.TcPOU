<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="TEN" Id="{48a4167d-326b-4179-a49a-d85a103bff69}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION TEN : LREAL
VAR_INPUT
	dd, mm, ss	: LREAL;
END_VAR
VAR
	fSign	: LREAL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// as IDLAstro's ten: a minus sign on any element makes the whole value negative, so TEN(-5, 30, 0) = -5.5
// (unlike IDL, a literal -0.0 is not recognised as negative)
IF (dd < 0.0) OR (mm < 0.0) OR (ss < 0.0) THEN
	fSign := -1.0;
ELSE
	fSign := 1.0;
END_IF
TEN := fSign * (ABS(dd) + (ABS(mm)/60.0) + (ABS(ss)/3600.0));
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>