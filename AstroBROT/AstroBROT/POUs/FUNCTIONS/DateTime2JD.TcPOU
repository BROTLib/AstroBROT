<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="DateTime2JD" Id="{99729b85-ef51-43f9-be01-c7ed25524dd9}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION DateTime2JD : LREAL
VAR_INPUT
	epoch			: TIMESTRUCT;
END_VAR
VAR
	a, y, m, jdn	: LREAL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Julian Date of a TIMESTRUCT (Meeus, Astronomical Algorithms, ch. 7; integer-day formula of the Gregorian calendar).
//
// - epoch must be UTC. The function does not convert or check the time zone; a local time gives a JD that is off by the
//   UTC offset, and with it the sidereal time (15 degrees per hour).
// - Gregorian calendar only, i.e. valid from 1582-10-15. Earlier dates would need the Julian-calendar formula.
// - No validation. Out-of-range fields roll over (month 13 is January of the next year, 30 February is 2 March), and an
//   all-zero TIMESTRUCT (e.g. a clock that has not been synchronised yet) gives 1721027.5, which is not a usable time.
a := FLOOR((14.0 - epoch.wMonth)/12.0);
y := epoch.wYear + 4800.0 - a;
m := epoch.wMonth + 12.0*a - 3.0;

jdn := epoch.wDay + FLOOR((153*m + 2)/5) + 365.0*y + FLOOR(y/4) - FLOOR(y/100) + FLOOR(y/400) - 32045.0;

DateTime2JD := jdn
			+ (epoch.wHour-12.0)/24.0
			+ (epoch.wMinute/1440.0) 
			+ (epoch.wSecond/86400.0)
			+ (DWORD_TO_REAL(epoch.wMilliseconds)/86400000.0);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>